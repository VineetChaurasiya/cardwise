# Supabase project (Settings > API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# Storage bucket for raw uploaded documents
SUPABASE_STORAGE_BUCKET=card-documents

# Google Gemini (free tier — get a key at https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-key
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001
GEMINI_CHAT_MODEL=gemini-3.1-flash-lite

# CORS — comma separated origins allowed to call this API
CORS_ORIGINS=http://localhost:5173
